# Social Poster configuration. Copy to .env and fill in what you use.
# Never commit .env. On Vercel, set these in Project Settings > Environment Variables.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development            # "production" enables strict checks, secure cookies and HSTS
PORT=3000
APP_URL=http://localhost:3000   # Public base URL; OAuth redirect URIs are built from it
LOG_LEVEL=                      # debug | info | warn | error (default: debug in dev, info in prod)
TRUST_PROXY=                    # e.g. 1 when behind one reverse proxy (set automatically on Vercel)

# ── Security (REQUIRED in production) ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts stored social tokens. Changing it makes existing tokens unreadable (users must reconnect).
ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=                   # Comma-separated extra origins allowed to call the API (usually empty)
RATE_LIMIT_ENABLED=true
CRON_SECRET=                    # Required to enable /api/cron/scheduler (Vercel Cron sends it automatically)

# ── Accounts ───────────────────────────────────────────────────────────────────
ALLOW_REGISTRATION=true         # false = only admins can create users
ADMIN_EMAIL=                    # Optional: create this admin on first start
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ── Database ───────────────────────────────────────────────────────────────────
# MySQL (production). Either DATABASE_URL or the DB_* variables.
DATABASE_URL=                   # mysql://user:password@host:3306/social_poster
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false                    # true for most hosted MySQL providers
DB_CONNECTION_LIMIT=
# Without MySQL settings, a local SQLite file (data/app.db) is used for development.
# SQLITE_FILE=data/app.db

# ── Media storage (Cloudinary) ─────────────────────────────────────────────────
# Required for Instagram and Pinterest (they download media from a public URL) and on Vercel.
CLOUDINARY_URL=                 # cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (or the three below)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=social-poster
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
MEDIA_UNUSED_TTL_HOURS=24       # uploads no post uses are deleted after this long

# ── Social platform apps (OAuth) ───────────────────────────────────────────────
# Redirect URI to register with each platform: {APP_URL}/api/oauth/{platform}/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
INSTAGRAM_APP_ID=               # Instagram app ID from the Meta app's "Instagram API with Instagram Login" product
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=               # YouTube Data API v3 OAuth client (Web application)
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=public   # public | unlisted | private
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY  # PUBLIC_TO_EVERYONE once TikTok has audited your app
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_API_BASE=https://api.pinterest.com   # https://api-sandbox.pinterest.com for Trial apps

# ── AI (server-wide defaults; users can also add their own key) ────────────────
AI_DEFAULT_PROVIDER=openai      # openai | gemini | openrouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=             # openrouter.ai/keys - one key, many models (OpenAI/Anthropic/Google/Meta/...)
OPENROUTER_MODEL=openai/gpt-4o-mini   # model names include the vendor, e.g. anthropic/claude-3.5-sonnet

# ── Scheduler ──────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=              # default: on for normal servers, off on Vercel (use the cron endpoint)
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_AUTO_RETRY_LIMIT=2    # automatic retries for temporary platform errors
SCHEDULER_MAX_LATENESS_HOURS=24 # don't publish posts missed by more than this
PUBLISH_MAX_ATTEMPTS=5          # manual retry limit per platform
