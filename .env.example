# Social Poster configuration. Copy to .env and fill in what you use.Never commit .env. On Vercel, set these in Project Settings > Environment Variables.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development           
PORT=3000
APP_URL=http://localhost:3000   
LOG_LEVEL=                      
TRUST_PROXY=                    

# ── Security (REQUIRED in production) ─ Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET= 
ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=                   
RATE_LIMIT_ENABLED=true
CRON_SECRET=                    

# ── Accounts ───────────────────────────────────────────────────────────────────
ALLOW_REGISTRATION=true         
ADMIN_EMAIL=                    
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ── Database ─────────────────────────── MySQL (production). Either DATABASE_URL or the DB_* variables.
DATABASE_URL=                   # mysql://user:password@host:3306/social_poster
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false                    
DB_CONNECTION_LIMIT=


# ── Media storage (Cloudinary) ───────────────── Required for Instagram and Pinterest (they download media from a public URL) and on Vercel.
CLOUDINARY_URL=                 # cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (or the three below)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=social-poster
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
MEDIA_UNUSED_TTL_HOURS=24       

# ── Social platform apps (OAuth) ───────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
INSTAGRAM_APP_ID=               
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=               
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=public   
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY  
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_API_BASE=https://api.pinterest.com   

# ── AI (server-wide defaults; users can also add their own key) ────────────────
AI_DEFAULT_PROVIDER=openai      
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=             # openrouter.ai/keys - one key, many models (OpenAI/Anthropic/Google/Meta/...)
OPENROUTER_MODEL=openai/gpt-4o-mini   

# ── Scheduler ──────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=              # default: on for normal servers, off on Vercel (use the cron endpoint)
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_AUTO_RETRY_LIMIT=2    
SCHEDULER_MAX_LATENESS_HOURS=24 
PUBLISH_MAX_ATTEMPTS=5          
